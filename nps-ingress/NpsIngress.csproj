<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>nps-ingress</AssemblyName>
    <RootNamespace>NPS.Daemon.Ingress</RootNamespace>
    <Version>1.0.0-alpha.19</Version>
    <Description>NPS Daemon — Layer 2 Internet ingress (nps-ingress). RFC-0006 TLS 1.3 terminator with ALPN nps/1.0, NIP mTLS/interactive session-NID binding, bounded handshake admission, executable TC-N2-Tls evidence, and local backend proxy. Broader AaaS/Anchor/product/deployment controls are not claimed.</Description>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NpsIngress.Tests" />
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LabAcacia.NPS.Core"        Version="1.0.0-alpha.19" />
    <PackageReference Include="LabAcacia.NPS.NWP"         Version="1.0.0-alpha.19" />
    <PackageReference Include="LabAcacia.NPS.NWP.Anchor"  Version="1.0.0-alpha.19" />
    <PackageReference Include="LabAcacia.NPS.NIP"         Version="1.0.0-alpha.19" />
  </ItemGroup>

</Project>
